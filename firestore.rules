rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Each authenticated user can only access their own single document: /workspaces/{userId}
    match /workspaces/{userId} {
      // Document owner can read and delete their own cloud vault
      allow read, delete: if isOwner(userId);

      // Document owner can create and update, capped strictly at 150 KB anti-bombing limit
      allow write: if isOwner(userId)
        && request.resource.data.payloadJson is string
        && request.resource.data.payloadJson.size() <= 150000;
    }
  }
}
